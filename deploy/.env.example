# 复制为 .env 并填写。切勿提交 .env 到版本库。
# 来源: 在你本机执行 `vertu-cli agent env --shell bash` 可得后四项

# ---- Vertu 服务认证(云端无桌面端, 必须显式注入) ----
VERTU_VPS_SERVICE_URL=
VERTU_APP_ID=
VERTU_APP_KEY=
VERTU_USER_LOGIN=

# ---- 业务参数 ----
CHANNEL_ID=e02a0a05-7997-4d50-b0b9-cad9754c0bdc
BOT_APP_ID=vbot_EIBezUGncpO8v0QJ
INTERVAL=30
POLL_MINUTES=60