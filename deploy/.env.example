# 复制为 .env 并填写。切勿提交 .env 到版本库。
# 来源: 在你本机执行 `vertu-cli agent env --shell bash` 可得认证四项(值带单引号要剥掉)

# ---- Vertu 服务认证(云端无桌面端, 必须显式注入) ----
VERTU_VPS_SERVICE_URL=
VERTU_APP_ID=
VERTU_APP_KEY=
VERTU_USER_LOGIN=

# ---- 业务参数 ----
CHANNEL_ID=e02a0a05-7997-4d50-b0b9-cad9754c0bdc
BOT_APP_ID=vbot_EIBezUGncpO8v0QJ
INTERVAL=30
POLL_MINUTES=60
# 巡检时刻(逗号分隔, 首个为全量), 对账小时
TRACK_TIMES=09:05,15:05
RECONCILE_HOUR=9
# watcher 状态文件多少分钟没更新判定假死并重启容器
WATCHER_STALE_MIN=10
# 对账/代理告警私信的管理员 user_id, 邮件收件人
ADMIN_USER_ID=13365
EMAIL_TO=

# ---- 出口代理(SS 节点, 必填, 否则 UPS/DHL 抓取失败) ----
XRAY_ADDR=
XRAY_PORT=
XRAY_METHOD=aes-256-gcm
XRAY_PASS=
# 备用节点(可选, 看门狗 s1 挂时自动切 s2)
XRAY2_ADDR=
XRAY2_PORT=
XRAY2_METHOD=aes-256-gcm
XRAY2_PASS=

# ---- 面单 OCR(Qwen 多模态, OpenAI 兼容接口) ----
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=

# ---- 可选: 告警邮件(腾讯企业邮箱), 不填则跳过发信 ----
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ---- 可选: 云表格同步 / V盘备份目录 ----
SHEET_DOC_ID=
BACKUP_PARENT_ID=
