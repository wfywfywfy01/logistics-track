# 复制为 .env 并填写。切勿提交 .env 到版本库。
# 来源: 在你本机执行 `vertu-cli agent env --shell bash` 可得认证四项(值带单引号要剥掉)

# ---- Vertu 服务认证(云端无桌面端, 必须显式注入) ----
VERTU_VPS_SERVICE_URL=
VERTU_APP_ID=
VERTU_APP_KEY=
VERTU_USER_LOGIN=

# ---- 业务参数 ----
CHANNEL_ID=e02a0a05-7997-4d50-b0b9-cad9754c0bdc
BOT_APP_ID=vbot_EIBezUGncpO8v0QJ
INTERVAL=30
POLL_MINUTES=60
# 巡检时刻(逗号分隔, 首个为全量), 对账小时
TRACK_TIMES=09:05,15:05
RECONCILE_HOUR=9
# watcher 状态文件多少分钟没更新判定假死并重启容器
WATCHER_STALE_MIN=10
# 对账/代理告警私信的管理员 user_id, 邮件收件人
ADMIN_USER_ID=13365
EMAIL_TO=

# ---- 出口代理(SS 节点, 必填, 否则 UPS/DHL 抓取失败) ----
XRAY_ADDR=
XRAY_PORT=
XRAY_METHOD=aes-256-gcm
XRAY_PASS=
# 备用节点(可选, 看门狗 s1 挂时自动切 s2)
XRAY2_ADDR=
XRAY2_PORT=
XRAY2_METHOD=aes-256-gcm
XRAY2_PASS=

# FedEx 与 DHL 一样走有头浏览器；可为 FedEx 单独指定出口。
FEDEX_PROXY=
FEDEX_DISABLE_HTTP2=1

# 管理工作台只绑定服务器回环地址，通过 SSH 隧道访问。
ADMIN_TOKEN=
ADMIN_HOST_PORT=8080
# 浏览器登录会话有效期；经 HTTPS 反向代理访问时将 Secure 设为 1。
ADMIN_SESSION_HOURS=12
ADMIN_COOKIE_SECURE=0
# 仅当可信反向代理覆盖 X-Forwarded-For 时启用。
ADMIN_TRUST_PROXY=0
# 未配置则不产生停滞判断，页面显示 N/A。
STALL_HOURS_UPS=
STALL_HOURS_DHL=
STALL_HOURS_FEDEX=
TRACKING_DATA_MAX_AGE_HOURS=
STEP_TIMEOUT_SECONDS=900
EVIDENCE_RETENTION_DAYS=30

# ---- 面单 OCR(Qwen 多模态, OpenAI 兼容接口) ----
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=
# 私有 CA 时填写证书文件路径；留空使用系统 CA。禁止关闭 TLS 校验。
OCR_CA_FILE=

# ---- 可选: 告警邮件(腾讯企业邮箱), 不填则跳过发信 ----
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ---- 可选: 云表格同步 / V盘备份目录 ----
SHEET_DOC_ID=
BACKUP_PARENT_ID=
# 本地持久备份自动保留天数。
BACKUP_RETENTION_DAYS=30
